{
	"private": true,
	"name": "engineering",
	"license": "MIT",
	"packageManager": "npm@10.9.3",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"fix": "concurrently -m 1 --group \"prettier --write .\" \"turbo fix\" \"stylelint \\\"**/*.css\\\" --fix --allow-empty-input --cache\" \"markdownlint-cli2 --fix \\\"**/*.md\\\"\" \"textlint --fix \\\"**/*.md\\\"\"",
		"check": "concurrently --group \"prettier --check .\" \"turbo check\" \"stylelint \\\"**/*.css\\\" -f unix --allow-empty-input --cache\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"textlint -f compact \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\"",
		"start": "turbo start",
		"unit": "turbo unit",
		"build": "turbo build",
		"binaries:fetch": "tsx scripts/binaries/fetch.ts",
		"binaries:install": "tsx scripts/binaries/install.ts",
		"fixtures:audio": "tsx scripts/fixtures/fetch-audio.ts",
		"fixtures:binaries": "tsx scripts/fixtures/fetch-binaries.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.0.0",
		"@html-eslint/eslint-plugin": "^0.64.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"concurrently": "^10.0.4",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-formatter-unix": "^9.0.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-barrel-files": "^2.1.0",
		"eslint-plugin-comment-rules": "^0.1.7",
		"eslint-plugin-import-x": "^4.0.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.0",
		"eslint-plugin-react-hooks": "^5.0.0",
		"globals": "^15.0.0",
		"jscpd": "^5.0.14",
		"knip": "^6.29.0",
		"markdownlint-cli2": "^0.23.2",
		"prettier": "^3.9.6",
		"stylelint": "^17.14.1",
		"stylelint-config-recommended": "^18.0.0",
		"textlint": "^15.7.1",
		"textlint-filter-rule-comments": "^1.3.0",
		"textlint-rule-no-dead-link": "^6.2.3",
		"tsx": "^4.21.0",
		"turbo": "^2.9.6",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.0.0"
	},
	"overrides": {
		"esbuild@^0.27": "^0.28.1",
		"brace-expansion@5": "5.0.9",
		"nanoid@3": "3.3.18"
	},
	"allowScripts": {
		"electron-winstaller": true,
		"esbuild": true,
		"unrs-resolver": true,
		"electron": true
	}
}
