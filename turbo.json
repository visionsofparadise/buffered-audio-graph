{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"check": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"index.html",
				"./tsconfig.json",
				"./package.json",
				"../../tsconfig.json",
				"../../eslint.config.js"
			],
			"outputs": []
		},
		"build": {
			"dependsOn": ["^build", "check"],
			"inputs": ["src/**", "./tsconfig.json", "./package.json"],
			"outputs": ["dist/**"]
		},
		"unit": {
			"dependsOn": ["check"]
		},
		"integration": {
			"dependsOn": ["build", "^integration"]
		},
		"integration:heavy": {
			"dependsOn": ["build", "^integration:heavy"]
		},
		"start": {},
		"lint": {
			"dependsOn": []
		},
		"docs": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "scripts/**", "README.md"],
			"outputs": ["README.md"]
		}
	}
}
